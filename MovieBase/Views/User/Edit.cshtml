@model MovieBase.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Сменить роль";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<h1 class="mb-4">@ViewData["Title"]</h1>
<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Edit" class="border p-4 shadow-sm rounded">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Username" class="form-label"></label>
                <div class="form-control-plaintext">@Html.DisplayFor(model => model.Username)</div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="form-control-plaintext">@Html.DisplayFor(model => model.Email)</div>
            </div>

            <div class="form-group mb-3">
                <label for="newRole" class="form-label">Новая роль</label>
                <select asp-for="Role" class="form-select" name="newRole" asp-items="@(new SelectList(ViewBag.Roles, "Name", "Name"))">
                    <option value="">Выберите роль</option>
                </select>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary" @(currentUserId == Model.Id ? "disabled" : "")>Изменить</button>
                <a asp-action="Index" class="btn btn-secondary">Вернуться</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
