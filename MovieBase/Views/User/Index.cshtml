@model IEnumerable<MovieBase.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "Пользователи";
}

<h1 class="my-4">Пользователи</h1>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Username)</th>
            <th>@Html.DisplayNameFor(model => model.Role)</th>
            <th class="text-center">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var isCurrentUser = item.Username == User.Identity.Name;
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                <td>@Html.DisplayFor(modelItem => item.Role)</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm @(isCurrentUser ? "disabled" : "")" title="Сменить роль"
                       data-disabled="@isCurrentUser">
                        <i class="fas fa-edit"></i> Сменить роль
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm @(isCurrentUser ? "disabled" : "")" title="Удалить"
                       data-disabled="@isCurrentUser">
                        <i class="fas fa-trash-alt"></i> Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const disabledLinks = document.querySelectorAll('a[data-disabled="True"]');
            disabledLinks.forEach(link => {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                });
            });
        });
    </script>
}
