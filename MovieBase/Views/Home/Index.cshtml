@model IEnumerable<MovieBase.Models.Movie>

@{
    ViewData["Title"] = "Главная";
}
<br/>
<div class="container">
    <div class="row justify-content-around row-cols-4">
        @foreach( Movie movie in Model)
        {
            <div class="card" style="width: 14rem;">
                <img src="@Url.Content("~/images/")@movie.ImageUrl" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">@movie.Name</h5>
                    <h6 class="card-subtitle mb-2 text-body-secondary">@movie.Country</h6>
                    <p>@movie.ReleaseYear</p>                               
                </div>
                <div>
                    <a asp-controller="UserMovie" asp-action="AddMovieToUser" asp-route-id="@movie.Id" class="btn btn-primary">Добавить в список просмотренного</a>
                </div>
                <div class="card-footer">
                </div>
            </div>
            <br />
            <br />
        }
        <br />
    </div>

</div>
