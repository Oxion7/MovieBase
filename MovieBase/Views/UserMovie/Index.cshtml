@model IEnumerable<MovieBase.Models.Movie>

@{
    ViewData["Title"] = "Список просмотренного";
}

<h1 class="text-center my-4">Список просмотренного</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info text-center">
        @TempData["Message"]
    </div>
}

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 d-flex align-items-stretch">
                <div class="card mb-4">
                    <div class="p-3">
                        <img src="~/images/@item.ImageUrl" class="card-img-top img-fluid rounded" alt="@item.Name">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text"><strong>Год выхода:</strong> @item.ReleaseYear</p>
                        <p class="card-text"><strong>Страна:</strong> @item.Country</p>
                        <p class="card-text"><strong>Описание:</strong> @item.Description</p>
                        <p class="card-text"><strong>Жанр:</strong> @item.Genre.Name</p>
                        <div class="mt-auto">
                            <a asp-controller="Movie" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Подробнее</a>
                            <a asp-controller="UserMovie" asp-action="DeleteMovieFromUser" asp-route-id="@item.Id" class="btn btn-danger">Удалить из списка</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
