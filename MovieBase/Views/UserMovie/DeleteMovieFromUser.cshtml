@model MovieBase.Models.Movie

@{
    ViewData["Title"] = "Удалить из списка";
}

<div class="container mt-5">
    <h1 class="text-center">@ViewData["Title"]</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info text-center">
            @TempData["Message"]
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h3>Уверены, что хотите удалить фильм из списка просмотренного?</h3>
                </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Название</dt>
                            <dd class="col-sm-8">@Model.Name</dd>

                            <dt class="col-sm-4">Год выхода</dt>
                            <dd class="col-sm-8">@Model.ReleaseYear</dd>

                            <dt class="col-sm-4">Страна</dt>
                            <dd class="col-sm-8">@Model.Country</dd>

                            <dt class="col-sm-4">Жанр</dt>
                            <dd class="col-sm-8">@Model.Genre.Name</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="card-footer text-center">
                <form asp-action="DeleteMovieFromUser" method="post" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger me-2">Удалить</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Вернуться</a>
            </div>
        </div>
    }
</div>
